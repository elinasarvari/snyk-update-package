# Every repo is cloned into repos/<name>/ - its code and the workflow changes stay there, never committed here.
# Only the list and its README are tracked.
repos/*
!repos/repos.txt
!repos/README.md

# Raw build/boot logs are large and machine-specific; summaries and diagnoses are kept.
*.log
workflows/_health/
.DS_Store
__pycache__/
test-results.txt

# Workflow records are personal: they stay on your machine, never in git (only workflows/README.md is tracked).
workflows/wf-*/
workflows/INDEX.md
workflows/.last-id

# Your own Claude Code permission answers ("Yes, and don't ask again") - personal, never committed.
.claude/settings.local.json
