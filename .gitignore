# Repos added by git URL are cloned into repos/<name>/ and never committed here.
# (Repos added as a local folder stay where they are.) Only the list and its README are tracked.
repos/*
!repos/repos.txt
!repos/README.md

# Raw build/boot logs are large and machine-specific; summaries and diagnoses are kept.
*.log
upgrades/_health/
.DS_Store
__pycache__/
