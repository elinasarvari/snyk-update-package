# Every repo is cloned into repos/<name>/ - its code and the workflow changes stay there, never committed here.
# Only the list and its README are tracked.
repos/*
!repos/repos.txt
!repos/README.md

# Raw build/boot logs are large and machine-specific; summaries and diagnoses are kept.
*.log
workflows/_health/
.DS_Store
__pycache__/
test-results.txt

# Workflow records ARE saved to git by `workflows.py save` / /dep-save (keep this repository private!),
# except bulky raw data that the documents already summarise:
workflows/*/snyk/*.json
!workflows/*/snyk/findings.json
workflows/*/snyk/*.err
workflows/*/**/.before-build.json
workflows/*/**/.summary-fields.txt
# The id counter is per machine; ids come from the folders (pulled before each new run).
workflows/.last-id

# Your own Claude Code permission answers ("Yes, and don't ask again") - personal, never committed.
.claude/settings.local.json

# The research cache (workflows/_research/) is saved too: every machine reuses it.
